<launch>
  <arg name="launch_rviz" default="true"/>
  <arg name="tasks_root"
       default="$(find buffered_footprint_planner)/environment/tasks"/>

  <node pkg="buffered_footprint_planner" type="simulation_node"
        name="buffered_footprint_simulation" output="screen" required="false">
    <rosparam command="load" file="$(find buffered_footprint_planner)/config/env.yaml"/>
    <rosparam command="load" file="$(find buffered_footprint_planner)/config/planner.yaml"/>
  </node>

  <node pkg="buffered_footprint_planner" type="scene_recorder_node"
        name="buffered_footprint_scene_recorder" output="screen" required="false">
    <rosparam command="load" file="$(find buffered_footprint_planner)/config/env.yaml"/>
    <rosparam command="load" file="$(find buffered_footprint_planner)/config/planner.yaml"/>
    <param name="tasks_root" value="$(arg tasks_root)"/>
    <param name="shutdown_launch_on_completion" value="true"/>
  </node>

  <node if="$(arg launch_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find buffered_footprint_planner)/config/rviz.rviz"/>
</launch>
